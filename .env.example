# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=crypto-events
KAFKA_GROUP_ID=coinbase-mysql-consumer

# Coinbase Exchange public WebSocket
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
COINBASE_PRODUCT_ID=BTC-USD
COINBASE_CHANNEL=ticker

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=crypto_database
MYSQL_USER=
MYSQL_PASSWORD=

# Runtime
LOG_LEVEL=INFO
RECONNECT_DELAY_SECONDS=5
CONSUMER_POLL_TIMEOUT_SECONDS=1